<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext allowed so http:// subscription URLs and bare-IP servers work -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
